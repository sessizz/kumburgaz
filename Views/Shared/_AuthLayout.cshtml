<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kumburgaz Yönetim</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="preload" href="/fonts/material-symbols-outlined.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/material-symbols.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />

    <style>
        :root, html[data-theme="light"] {
            --color-primary: #0e7c86 !important;
            --color-primary-content: #ffffff !important;
        }
        * { font-family: "Inter", system-ui, sans-serif; }
        .material-symbols-outlined {
            font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 22;
            vertical-align: middle;
            font-size: 20px;
            line-height: 1;
        }
    </style>
</head>
<body style="background:#f3f4f6; min-height:100vh; display:flex; align-items:center; justify-content:center;">
    <div style="width:100%; max-width:420px; padding:16px;">
        <div class="text-center mb-6">
            <div class="inline-flex items-center gap-2 mb-1">
                <span class="material-symbols-outlined text-blue-600" style="font-size:28px;">apartment</span>
                <span class="text-2xl font-bold text-gray-900 tracking-tight">kumburgaz</span>
            </div>
            <p class="text-sm text-gray-400">Site Yönetim Sistemi</p>
        </div>
        @RenderBody()
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
