@using Kumburgaz.Web.Controllers
@model List<ConnectedAppRow>
@{
    ViewData["Title"] = "Bağlı uygulamalar";
    var isAdmin = User.IsInRole(Kumburgaz.Web.Models.AppRoles.SistemYonetici);
}

<div class="space-y-4">
    <div>
        <h2 class="text-2xl font-extrabold">Bağlı uygulamalar</h2>
        <p class="text-sm text-gray-400">Hesabınıza erişim izni verdiğiniz uygulamalar (ör. Claude). İptal ettiğinizde uygulama oturumu hemen sona erer.</p>
    </div>

    @if (TempData["ActionSuccess"] is string okMsg)
    {
        <div class="alert alert-success"><span>@okMsg</span></div>
    }

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-x-auto">
        <table class="table w-full">
            <thead>
                <tr>
                    <th>Uygulama</th>
                    @if (isAdmin) { <th>Kullanıcı</th> }
                    <th>Bağlanma tarihi</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td class="font-semibold">@row.ClientName</td>
                        @if (isAdmin) { <td>@row.OwnerName</td> }
                        <td>@(row.CreatedAt.HasValue ? row.CreatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "-")</td>
                        <td>@(row.Active ? "Aktif" : "İptal edildi")</td>
                        <td class="text-right">
                            @if (row.Active)
                            {
                                <form asp-action="Revoke" asp-route-id="@row.Id" method="post" onsubmit="return confirm('Bu bağlantı iptal edilsin mi?');">
                                    <button type="submit" class="btn btn-sm btn-outline btn-error">İptal et</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="@(isAdmin ? 5 : 4)" class="text-center text-gray-400 py-6">Bağlı uygulama yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
